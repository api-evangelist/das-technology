                "type": "path",
                "description": "A guid identifying the account."
              }
            ]
          },
          "docs": "Retrieves a list of competitors for an account."
        },
        {
          "info": {
            "name": "Sets a list of account guids as the competitor list.  Duplicate accounts are suppressed.\r\nIf an account guid does not exist, a 404 error will be returned.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v2/account/:accountGuid/competitor",
            "params": [
              {
                "name": "accountGuid",
                "value": "",
                "type": "path",
                "description": "A guid representing the account"
              }
            ]
          },
          "docs": "Sets a list of account guids as the competitor list.  Duplicate accounts are suppressed.\r\nIf an account guid does not exist, a 404 error will be returned."
        },
        {
          "info": {
            "name": "Deletes an account competitor from the the competitor list.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
